# Local loopback defaults. Do not put passwords here.
LOVE_CLOUD_BIND=127.0.0.1
LOVE_CLOUD_PORT=3211
APP_ORIGIN=http://localhost:3211
SECURE_COOKIES=false
# Installer persists these; preserve them on upgrade. Do not add a version suffix.
COMPOSE_PROJECT_NAME=lovecloud
# Installer selects compose.images.yaml when present in the release archive.
# Linux separator ':'; Windows ';' (COMPOSE_PATH_SEPARATOR is saved automatically).
# COMPOSE_FILE=compose.yaml:compose.images.yaml
# COMPOSE_PATH_SEPARATOR=:
# Optional public HTTPS: set APP_ORIGIN=https://your.domain, LOVE_CLOUD_DOMAIN,
# and include compose.https.yaml. A separately managed reverse proxy may use
# APP_ORIGIN=https://your.domain without the bundled Caddy override.
# LOVE_CLOUD_DOMAIN=your.domain
# Encrypted backup helper pinned by release.env in the installation bundle.
# LOVECLOUD_BACKUP_IMAGE=restic/restic@sha256:<release digest>
